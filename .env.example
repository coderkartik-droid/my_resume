# ==============================================================================
# MY_RESUME — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env or .env.local and populate the secrets appropriately.
# NEVER commit the actual .env file containing live secrets to public version control.

# Database Connection (SQLite local file)
DATABASE_URL="file:./dev.db"

# JSON Web Token (JWT) Secret Key
# Required in production. Minimum 32 characters, cryptographically random.
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# Default Admin Credentials (Used by seed script only when database has 0 admin accounts)
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="REPLACE_WITH_SECURE_ADMIN_PASSWORD"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# Server Port
PORT=3000
