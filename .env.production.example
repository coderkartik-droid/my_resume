# ==============================================================================
# HOSTINGRAJA PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Workspace: E:\kartik\my_resume
# ==============================================================================
# Copy this file to .env or .env.production on your HostingRaja server,
# or enter these key-value pairs into cPanel's "Setup Node.js App" Environment Variables.

# 1. DATABASE CONNECTION (Prisma SQLite)
# Note: For SQLite in Prisma, relative paths are resolved relative to the prisma/ folder.
# Option A (Standard relative path):
DATABASE_URL="file:./dev.db"

# Option B (Absolute path on HostingRaja - replace 'username' and 'portfolio' with your cPanel username & directory):
# DATABASE_URL="file:/home/USERNAME/portfolio/prisma/dev.db"

# 2. JWT SECURITY KEY (Authentication & Session Tokens)
# Replace with a cryptographically secure random string (minimum 32 characters)
# Generate a new key using SSH: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# 3. NODE ENVIRONMENT
NODE_ENV="production"

# 4. SERVER BINDING & PORT
# HostingRaja CloudLinux / Phusion Passenger dynamically provides process.env.PORT.
# Fallback settings:
PORT=3000
HOST="0.0.0.0"
