# Environment secrets - never upload
.env
.env.*
!.env.example

# Database files - preserve locally, never upload
*.db
*.db-journal
*.db.*
*.sqlite
*.sqlite3
*.pre_files_backup
*.db.backup
*.db.bak

# Git
.git/

# Logs
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor temporary files
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak

# Coverage reports
coverage/

# Dependencies and build output — kept on disk, intentionally not pushed
node_modules/
.next/
out/

# Large local artifacts and snapshots — kept on disk, intentionally not pushed
deploy/
backups/
.screenshots/

# Local tooling artifacts
cookies.txt
.gitignore.backup
*.tsbuildinfo